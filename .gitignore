# ── Build artifacts (rebuilt, never published) ──
target/
**/target/

# Dart/Flutter local state
.dart_tool/
.packages

# ── Sensitive material — NEVER commit ──
# Keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt.bak
# Environment / secrets files
.env
.env.*
!.env.example
secrets.*
*secret*.json
credentials*.json
*_credentials.json
# Test fixtures that may contain real data
**/fixtures/private/
**/fixtures/*real*/
# Editor / OS noise
.DS_Store
Thumbs.db

# NOTE: bindings/wasm/pkg and bindings/wasm/pkg-node are COMMITTED on
# purpose — they are the prebuilt consumables (~500 KB each) so that
#   npm install everabyte/crypto-sdk#path:bindings/wasm/pkg
# works without a Rust toolchain. Rebuild with `wasm-pack build` when the
# core changes; the frozen vectors in vectors/ are synthetic test material.
